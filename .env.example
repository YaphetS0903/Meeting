APP_ENV=development
DATABASE_URL=postgresql+psycopg://meetings:meetings@localhost:55436/meetings
REDIS_URL=redis://localhost:56386/0
PUBLIC_URL=http://localhost:5176
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8086
# 生产环境必须更换为独立的长随机值。
JWT_SECRET=local-development-only-change-before-deploy-32chars
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# 仅用于补充通讯录手机号、邮箱和派发权限；登录、消息仍用上面的应用
WECOM_DIRECTORY_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
# OpenAI 兼容接口；火山 Agent Plan 请填写控制台给出的专属 Base URL、API Key 和模型。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=90
NATIVE_TODO_ENABLED=false
# 自建应用 JS-SDK 创建新待办；开启后直接派发不再由机器人自动创建。
NATIVE_TODO_APP_ENABLED=false
# 直接任务应用消息独立开启，会议提醒和邮件仍由成员提醒总开关控制。
WECOM_DIRECT_NOTIFICATIONS_ENABLED=false
# 总开关开启后，默认仅允许直接派发；会议任务须单独开启。
NATIVE_TODO_DIRECT_ENABLED=true
NATIVE_TODO_MEETING_ENABLED=false
# 开启后覆盖全部在用企业微信员工；关闭时仅覆盖下方白名单。
NATIVE_TODO_ALL_ACTIVE_USERS=false
# 受限范围使用自建应用通讯录 wecom_id，逗号分隔。
NATIVE_TODO_ALLOWED_WECOM_IDS=
NATIVE_TODO_CLI_PATH=/usr/local/bin/wecom-cli
# 独立监控；Webhook 生产地址须使用 HTTPS，也可通过现有 SMTP 发给指定邮箱。
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ALERT_EMAIL_TO=
ALERT_REMINDER_MINUTES=60
BACKUP_ALERT_REMINDER_MINUTES=1440
MONITOR_INTERVAL_SECONDS=60
MONITOR_HEARTBEAT_SECONDS=180
MONITOR_QUEUE_MINUTES=15
MONITOR_FREE_MB=512
MONITOR_BACKUP_HOURS=48
